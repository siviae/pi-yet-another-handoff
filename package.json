{
  "name": "pi-yet-another-handoff",
  "version": "0.1.3",
  "description": "Confirmation-free Pi session handoff with a customizable handoff template",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "handoff"
  ],
  "files": [
    "src/",
    "handoff-document.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/extension.js"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/config.js && node --check src/handoff.js",
    "test:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0"
  }
}
